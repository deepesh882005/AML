import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from hmmlearn import hmm 
from sklearn.metrics import accuracy_score

states=['rainy','sunny']
n_states=len(states)
observations=['walk','shop','clean']
n_observations=len(observations)

obs_seq=['walk','shop','clean','clean','walk','walk','shop']
obs_map={obse:i for i,obse in enumerate(observations)}
obs_seq_encoded=np.array([obs_map[obs] for obs in obs_seq]).reshape(-1,1)
# print(obs_seq_encoded)

actual_seq=['sunny','rainy','rainy','rainy','sunny','sunny','rainy']
state_map={state:i for i,state in enumerate(states)}
actual_seq_encoded=np.array([state_map[state] for state in actual_seq]).reshape(-1,1)
# print(actual_seq_encoded)


start_prob=np.array([0.6,0.4])
transition_prob=np.array([[0.7,0.3],[0.4,0.6]])
emission_prob=np.array([[0.1,0.4,0.5],[0.6,0.3,0.1]])

model=hmm.CategoricalHMM(n_components=n_states)
model.startprob_=start_prob
model.transmat_=transition_prob
model.emissionprob_=emission_prob

logprob,predicted_states=model.decode(obs_seq_encoded,algorithm='viterbi')
predicted_state_names=[states[state] for state in predicted_states]
# print(predicted_state_names)
accuracy = accuracy_score(actual_seq_encoded, predicted_states)
print(f"Most likely states by Viterbi: {predicted_state_names}")
print(f"Actual states: {actual_seq}")
print(f"Accuracy: {accuracy:.2f}")
print(f"Log Probability of sequence: {logprob:.2f}")

def plot_matrix(matrix,label_row,label_col,title):
  plt.figure(figsize=(10,6))
  sns.heatmap(matrix,annot=True,xticklabels=label_col,yticklabels=label_row)
  plt.title(title)
  plt.xlabel("to")
  plt.ylabel("from")
  plt.show()
plot_matrix(model.transmat_,states,states,"state Transition Probabilty")
plot_matrix(model.emissionprob_,states,observations,"Emission Probability")
