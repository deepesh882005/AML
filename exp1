import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler,OneHotEncoder
from sklearn.compose import ColumnTransformer
from sklearn.linear_model import LinearRegression,Ridge,Lasso,ElasticNet
from sklearn.metrics import mean_squared_error,r2_score

data=pd.read_csv(r"https://raw.githubusercontent.com/sonarsushant/California-House-Price-Prediction/refs/heads/master/housing.csv")
# print(data.head(5))
data=data.dropna()
data=data.drop(columns=["ocean_proximity"])
print(data.head(5))
X=data.drop(columns=['median_house_value'])
Y=data['median_house_value']
X_train,X_test,Y_train,Y_test=train_test_split(X,Y,test_size=0.3,random_state=42)
numerical_col=['longitude','latitude','housing_median_age','total_rooms','total_bedrooms','population','households','median_income']
categorical_col=[]
preprocessor=ColumnTransformer(transformers=[
    ("num",StandardScaler(),numerical_col),
    ("cat",OneHotEncoder(),categorical_col)
])
X_train=preprocessor.fit_transform(X_train)
X_test=preprocessor.transform(X_test)
model={
    "LinearRegression":LinearRegression(),
    "Ridge":Ridge(alpha=1.0),
    "Lasso":Lasso(alpha=100),
    "ElasticNet":ElasticNet(alpha=0.1,l1_ratio=0.5)
}

coefficients={}
for name,model in model.items():
  model.fit(X_train,Y_train)
  coefficients[name]=model.coef_
  y_pred=model.predict(X_test)
  mse=mean_squared_error(Y_test,y_pred)
  r2=r2_score(Y_test,y_pred)
  print("-"*60)
  print(f"{name} coefficients:{model.coef_}")
  print(f"{name} MSE:{mse}")
  print(f"{name} R2 Score:{r2}")
  plt.figure(figsize=(12,6))
for name,coef in coefficients.items():
  plt.plot(coef,label=name)
plt.xlabel("Model Comparision")
plt.ylabel("Coefficient Value")
plt.legend()
plt.grid(True)
plt.show()
